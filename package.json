{
  "name": "skyline-flight-simulator",
  "version": "2.0.0",
  "private": true,
  "description": "SkyLine Flight Simulator - web version (GitHub Pages, runs on iPad) and Unreal Engine 5 version",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview --open --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --no-warnings tests/fdm.test.ts",
    "test:sim": "cmake -S tests/sim -B build/sim -DCMAKE_BUILD_TYPE=Release && cmake --build build/sim -j && ./build/sim/flight_tests",
    "data": "node tools/build-data.mjs",
    "aircraft": "node tools/fgconv/convert.mjs",
    "aircraft:ipad": "node tools/fgconv/convert.mjs --profile ipad"
  },
  "dependencies": {
    "cesium": "^1.145.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
