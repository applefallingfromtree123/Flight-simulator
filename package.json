{
  "name": "skyline-flight-simulator",
  "version": "2.0.0",
  "private": true,
  "description": "SkyLine Flight Simulator (Unreal Engine 5, PC + iPad) - asset pipeline and data tools",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "aircraft": "node tools/fgconv/convert.mjs",
    "aircraft:ipad": "node tools/fgconv/convert.mjs --profile ipad",
    "data": "node tools/build-data.mjs",
    "test": "cmake -S tests/sim -B build/sim -DCMAKE_BUILD_TYPE=Release && cmake --build build/sim -j && ./build/sim/flight_tests"
  }
}
