{
  "name": "skyline-flight-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Professional real-world flight simulator — custom flight dynamics engine on a real-world globe (CesiumJS)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview --open --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --no-warnings tests/fdm.test.ts",
    "data": "node tools/build-data.mjs",
    "aircraft": "node tools/fgconv/convert.mjs",
    "test:sim": "cmake -S tests/sim -B build/sim -DCMAKE_BUILD_TYPE=Release && cmake --build build/sim -j && ./build/sim/flight_tests"
  },
  "dependencies": {
    "cesium": "^1.145.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
