    "data": "node tools/build-data.mjs"
  },
  "dependencies": {
    "cesium": "^1.145.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
